# ====================================================================
# CIPERX — AI-Powered Criminal Network Analysis System
# Backend Environment Configuration
# ====================================================================

# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Neo4j Graph Database Settings
# For Neo4j Desktop or local Community Edition, default bolt port is 7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ciperx_password
NEO4J_DATABASE=neo4j

# Security & Authorization
API_KEY=ciperx_dev_token_2026
ALLOWED_ROLES=Investigator,Analyst,Supervisor,Admin

# CORS Origin for Local React Frontend
FRONTEND_ORIGIN=http://localhost:5173
